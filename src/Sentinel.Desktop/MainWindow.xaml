<Window x:Class="Sentinel.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="SENTINEL Enterprise V1.1" Width="1440" Height="900" MinWidth="800" MinHeight="480" WindowStartupLocation="CenterScreen">
  <Grid x:Name="ShellRoot" Background="{DynamicResource BackgroundBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="12,16,12,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="4,0,4,20"><StackPanel Orientation="Horizontal"><Path Width="28" Height="32" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" Data="M14,0 L28,5 L26,20 L14,31 L2,20 L0,5 Z M7,8 L7,15 L12,20 L22,9 L19,6 L12,14 L10,11 Z"/><StackPanel x:Name="BrandLabel" Margin="12,0,0,0"><TextBlock Text="SENTINEL" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="ENTERPRISE SECURITY" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></StackPanel></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Navigation"/></ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="CompactNavigationButton" Click="ToggleNavigation_Click" ToolTip="Toggle compact navigation" AutomationProperties.Name="Toggle compact navigation" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" Stretch="Uniform" Data="M1,1 H17 V17 H1 Z M6,1 V17 M10,6 H14 M10,10 H14"/><TextBlock x:Name="CompactNavigationLabel" Text="Compact navigation" Margin="12,0,0,0"/></StackPanel></Button><TextBlock x:Name="VersionLabel" Text="V1.1 · LOCAL EVIDENCE" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="8,12,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <WrapPanel VerticalAlignment="Center"><Border x:Name="EnvironmentModeBadge" Background="{DynamicResource ElevatedBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,12,0"><TextBlock x:Name="ModeText" Text="LOCAL" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></Border><StackPanel Margin="0,0,16,0"><TextBlock x:Name="OrganizationText" Text="Choose an environment" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="EnvironmentContextText" Text="Evidence stays on this computer" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><StackPanel x:Name="AssessmentContext" Margin="0,0,12,0"><TextBlock x:Name="AssessmentText" Text="Assessment not started" FontSize="12" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="MonitoringText" Text="On-demand assessments" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></WrapPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Click="Notifications_Click" ToolTip="Security changes and notifications" AutomationProperties.Name="Notifications"><Path Width="18" Height="18" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Stretch="Uniform" Data="M3,14 H15 L13,11 V6 C13,1 5,1 5,6 V11 Z M7,16 C7,19 11,19 11,16"/></Button><Button Click="Settings_Click" ToolTip="Application settings" AutomationProperties.Name="Application settings"><Path Width="18" Height="18" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Stretch="Uniform" Data="M9,1 V4 M9,14 V17 M1,9 H4 M14,9 H17 M3,3 L5,5 M13,13 L15,15 M3,15 L5,13 M13,5 L15,3 M9,5 A4,4 0 1 0 9,13 A4,4 0 1 0 9,5"/></Button></StackPanel>
      </Grid></Border>
      <Border Grid.Row="1" Padding="24,20,24,16"><StackPanel><TextBlock x:Name="PageTitle" Text="Command Center" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Know what can hurt the organization. Fix what matters first." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,12"/><WrapPanel><Button Content="Switch environment" Click="SwitchEnvironment_Click"/><Button x:Name="ScanButton" Content="New assessment" Style="{StaticResource PrimaryButton}" Click="ScanButton_Click"/><TextBlock x:Name="PageContextText" Text="" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/></WrapPanel></StackPanel></Border>
      <Border x:Name="NoticeBorder" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource ElevatedBrush}" Padding="16,12" Margin="24,0,24,16" CornerRadius="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="NoticeText" FontWeight="SemiBold"/><Expander x:Name="NoticeTechnical" Header="Details and correlation ID" Margin="0,8,0,0"><TextBlock x:Name="NoticeDetail" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></Expander></StackPanel><Button Grid.Column="1" Content="Dismiss" Click="DismissNotice_Click" VerticalAlignment="Top"/></Grid></Border>
      <ScrollViewer Grid.Row="3" x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PageContent" Margin="24,0,24,24"/></ScrollViewer>
      <Border Grid.Row="4" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusText" Text="Opening your local workspace…" FontSize="12" Foreground="{DynamicResource MutedBrush}"/><ProgressBar x:Name="Progress" Visibility="Collapsed" IsIndeterminate="True" Height="3" Margin="0,8,12,0" Foreground="{DynamicResource AccentBrush}"/></StackPanel><Button Grid.Column="1" x:Name="CancelScanButton" Content="Cancel assessment" Visibility="Collapsed" Click="CancelScan_Click"/></Grid></Border>
    </Grid>
  </Grid>
</Window>
