<Window x:Class="Sentinel.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SENTINEL Enterprise" Width="1480" Height="950" MinWidth="1080" MinHeight="700" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="246"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="14,20,14,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="9,0,0,20"><StackPanel Orientation="Horizontal"><Path Width="28" Height="31" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" Data="M 14,0 L 28,5 L 26,20 L 14,31 L 2,20 L 0,5 Z M 7,8 L 7,15 L 12,20 L 22,9 L 19,6 L 12,14 L 10,11 Z"/><TextBlock Text="SENTINEL" FontSize="23" FontWeight="Bold" Margin="10,1,0,0"/></StackPanel><TextBlock Text="ENTERPRISE SECURITY" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,0"/></StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="7" Padding="12,9" Margin="0,0,0,10"><StackPanel><TextBlock x:Name="OrganizationText" Text="Choose an environment" FontWeight="SemiBold"/><TextBlock x:Name="ModeText" Text="Local standalone workspace" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></Border>
        <ListBox Grid.Row="2" x:Name="Navigation" SelectionChanged="Navigation_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        <StackPanel Grid.Row="3" Margin="8,12,0,0"><TextBlock Text="V1.0 · LOCAL EVIDENCE" FontSize="12" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="Evidence → context → action" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,22,24,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Command Center" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Know what can hurt the organization. Fix what matters first." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Switch environment" Click="SwitchEnvironment_Click"/><Button x:Name="ScanButton" Content="New assessment" Style="{StaticResource PrimaryButton}" Click="ScanButton_Click"/></StackPanel></Grid></Border>
      <Border x:Name="NoticeBorder" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource ElevatedBrush}" Padding="18,10" Margin="28,14,28,0" CornerRadius="7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="NoticeText"/><TextBlock x:Name="NoticeDetail" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="Dismiss" Click="DismissNotice_Click"/></Grid></Border>
      <ScrollViewer Grid.Row="2" x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PageContent" Margin="28,24,28,28"/></ScrollViewer>
      <Border Grid.Row="3" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusText" Text="Opening your secure local workspace…" FontSize="12" Foreground="{DynamicResource MutedBrush}"/><ProgressBar x:Name="Progress" Visibility="Collapsed" IsIndeterminate="True" Height="3" Margin="0,7,20,0" Foreground="{DynamicResource AccentBrush}"/></StackPanel><Button Grid.Column="1" x:Name="CancelScanButton" Content="Cancel assessment" Visibility="Collapsed" Click="CancelScan_Click"/></Grid></Border>
    </Grid>
  </Grid>
</Window>
